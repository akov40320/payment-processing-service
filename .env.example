APP_NAME=payment-processing-service
ENVIRONMENT=development
API_KEY=replace-this-with-a-long-random-secret
POSTGRES_PASSWORD=replace-this-database-password
RABBITMQ_USER=payments
RABBITMQ_PASSWORD=replace-this-rabbitmq-password
DATABASE_URL=postgresql+asyncpg://payments:payments@postgres:5432/payments
RABBITMQ_URL=amqp://payments:payments@rabbitmq:5672/
PAYMENT_PROCESSING_MIN_DELAY=2
PAYMENT_PROCESSING_MAX_DELAY=5
PAYMENT_SUCCESS_RATE=0.9
WEBHOOK_TIMEOUT_SECONDS=5
OUTBOX_POLL_INTERVAL_SECONDS=1
WEBHOOK_POLL_INTERVAL_SECONDS=1
